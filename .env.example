# ProofWeave needs NO real credentials.  All data in the shipped snapshot is
# from public SEC EDGAR filings and official company newsrooms.
#
# This file exists as a template; copy to `.env` if you later add an optional
# re-crawling script.  Never commit real keys.

# Optional: set a custom snapshot path if you generate a new one.
PROOFWEAVE_SNAPSHOT=proofweave/data/snapshot_2026_09_29.json

# Optional: SEC EDGAR requires a User-Agent / contact email for polite crawling.
# Fill with your own email if you run scripts/refresh_snapshot.py.
SEC_USER_AGENT="Your Name you@example.com"
